# FitMaker Web Application Environment Configuration
# Copy this file to '.env.local' or '.env' before running in production.

# Application Base Settings
VITE_APP_NAME="FitMaker"
VITE_APP_URL="https://fitmaker.com"
VITE_API_BASE_URL="https://api.fitmaker.com/v1"

# Authentication & Security
VITE_AUTH_DOMAIN="auth.fitmaker.com"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Content Security & Analytics
VITE_ENABLE_SECURITY_HEADERS=true
VITE_ANALYTICS_ID=""
